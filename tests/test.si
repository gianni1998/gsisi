fn add(a: int, b: int): int {
    return (a + b);
}

fn main(): int {
    let limit: int = 10;
    let sum: int = 0;
    let i: int = 1;
    let remove: bool = false;

    while (i <= limit) {
        sum = add(sum, i);
        i = i + 1;
    }

    out(sum); // Should eventually output 55

    return 1;
}